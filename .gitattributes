# Normalise to LF in the repository, and let Git decide the working-copy form.
* text=auto

# These are read by Linux inside containers. A CRLF checkout on Windows breaks
# the shebang and the container fails with a misleading "no such file or
# directory", so force LF regardless of core.autocrlf.
*.sh            text eol=lf
Dockerfile      text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
.dockerignore   text eol=lf

# Binary
*.png binary
*.jpg binary
*.apk binary
*.keystore binary
*.jks binary
