# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#   cp .env.example .env
#
# Generate a JWT secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# ---- Runtime ----
# `production` enforces strict config validation and disables the /docs UI.
APP_ENV=development

# ---- PostgreSQL ----
POSTGRES_USER=vpn_admin
POSTGRES_PASSWORD=
POSTGRES_DB=shieldvpn

# ---- Auth ----
# REQUIRED. Must be >= 32 chars and unique per environment.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- CORS ----
# Comma-separated browser origins allowed to call the API (the admin dashboard).
CORS_ORIGINS=http://localhost:3000

# ---- First-boot admin ----
# Used once, on first startup, to create the initial admin account.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ---- Android build (secrets-gradle-plugin) ----
# Base URL the mobile client points at.
API_BASE_URL=http://10.0.2.2:8000
